# Copy this to .env for local dev with `vercel dev` (never commit the real .env).
# In production, set these in the Vercel dashboard:
# Project -> Settings -> Environment Variables

# Required: your TokenRouter API key (kept server-side only, never sent to the browser)
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here

# Optional: TokenRouter base URL. Defaults to https://api.tokenrouter.io/v1 if unset.
TOKENROUTER_BASE_URL=https://api.tokenrouter.io/v1

# Optional: which model to use. Set this to a model supported by TokenRouter.
CHAT_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional: your site URL (informational purposes only)
SITE_URL=https://csit-igris.vercel.app
